module tests.conformance.trusted.pass.trusted_block_mmio_read32;
profile trusted;

// Pass case: a `trusted!` block performing a 32-bit MMIO read against a
// named MmioRegion enum value declared in trusted_profile.toml.

fn read_apic_id() -> u32 {
    let mut value: u32 = 0;
    // trust-audit: ember/docs/EMBER_TRUST_AUDIT.md#apic-id-read
    trusted! {
        value = mmio_read32(MmioRegion::ApicBase, 32);
    }
    value
}
