module tests.conformance.boot.fail.field_access_on_non_struct;

// fail-expected: K-003
//
// Field access requires the base expression to resolve to a struct
// type. K-003 (field access on non-struct) is emitted when the base
// is a literal or other non-struct expression.

fn access_literal_field() -> u32 {
    let n: u32 = 42;
    n.value
}
