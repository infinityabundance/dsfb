module pcc.host_tools.phosphoric_fuzz;
profile host;

// Deterministic-seed grammar fuzzer.
//
// Uses an internal LCG (linear congruential generator) seeded from an
// explicit u64 value. Generates random-but-reproducible Phosphoric source
// fragments according to a declared grammar bias profile. Runs each fragment
// through the parser, typeck, effect checker, and PE writer (where applicable).
//
// The corpus of seeds is COMMITTED. Each release adds new seeds; old seeds
// are never removed. Golden output hashes are stored alongside seeds.
// Any panic, any output-hash divergence between runs, fails CI.
//
// This is NOT a coverage-guided fuzzer. It is a property-tester with a
// deterministic, append-only seed corpus.
//
// Following the same trust-boundary pattern as phosphoric_test_runner:
// the makefile rule has already invoked pcc on each generated fragment
// and captured exit/stderr to side-channel files; this tool reads + hashes
// the captured outputs and compares to the golden table.

struct LcgState {
    state: u64,
}

// Knuth's MMIX constants. Pure deterministic; no external entropy.
fn lcg_next(s: LcgState) -> LcgState {
    let next: u64 = s.state * 6364136223846793005 + 1442695040888963407;
    LcgState { state: next }
}

// Project the high 32 bits of LCG state to a u32. Higher-order bits are
// statistically better-mixed than low-order bits in a linear congruential
// generator.
fn lcg_u32(s: LcgState) -> u32 {
    (s.state / 4294967296) as u32
}

// Bounded-modulo from LCG: return value in [0, modulus). modulus must be > 0.
fn lcg_range(s: LcgState, modulus: u32) -> u32 {
    let v: u32 = lcg_u32(s);
    v - (v / modulus) * modulus
}

struct FuzzSeed {
    seed_id: u32,
    seed_value: u64,
    expected_outcome_hash: [u8; 32],
}

struct FuzzOutcome {
    seed_id: u32,
    panicked: bool,
    actual_hash: [u8; 32],
    matches_golden: bool,
}

// Compare two SHA-256 hashes for equality.
fn sha_eq(a: [u8; 32], b: [u8; 32]) -> bool {
    #[bound = 32]
    for i in 0..32 {
        match a[i] == b[i] {
            true  => (),
            false => return false,
        }
    }
    true
}

// Token kind selected by the generator. Each kind expands to a fixed,
// finite, v0-grammar-conformant byte fragment. The set is intentionally
// tiny: the goal is to exercise the parser dispatch table, not to
// enumerate every production.
enum FuzzTokenKind {
    FnKw,           // "fn "
    StructKw,       // "struct "
    EnumKw,         // "enum "
    LetKw,          // "let "
    MatchKw,        // "match "
    ForKw,          // "for "
    IdentA,         // "a"
    IdentB,         // "b"
    IdentC,         // "c"
    Lparen,         // "("
    Rparen,         // ")"
    Lbrace,         // "{"
    Rbrace,         // "}"
    Semi,           // ";"
    LineFeed,       // "\n"
}

// Emit a single byte at cursor; return new cursor.
fn put_byte(out: Slice[u8, 65536], cursor: u32, b: u8) -> u32 {
    out[cursor] = b;
    cursor + 1
}

// Pick a token kind from a 16-bin LCG draw. The distribution is uniform
// across the 15 enum variants; bin 15 wraps to LineFeed.
fn pick_token(s: LcgState) -> FuzzTokenKind {
    let bin: u32 = lcg_range(s, 15);
    match bin {
        0  => FuzzTokenKind::FnKw,
        1  => FuzzTokenKind::StructKw,
        2  => FuzzTokenKind::EnumKw,
        3  => FuzzTokenKind::LetKw,
        4  => FuzzTokenKind::MatchKw,
        5  => FuzzTokenKind::ForKw,
        6  => FuzzTokenKind::IdentA,
        7  => FuzzTokenKind::IdentB,
        8  => FuzzTokenKind::IdentC,
        9  => FuzzTokenKind::Lparen,
        10 => FuzzTokenKind::Rparen,
        11 => FuzzTokenKind::Lbrace,
        12 => FuzzTokenKind::Rbrace,
        13 => FuzzTokenKind::Semi,
        _  => FuzzTokenKind::LineFeed,
    }
}

// Emit a token's bytes into out at cursor; advance cursor.
//
// Byte sequences are spelled out as integer literals (Phosphoric has no
// string literals in v0). Same convention as the lexer's keyword tables.
fn emit_token(
    out: Slice[u8, 65536],
    cursor: u32,
    tok: FuzzTokenKind,
) -> u32 {
    match tok {
        FuzzTokenKind::FnKw => {
            // "fn "
            let c1: u32 = put_byte(out, cursor, 102);
            let c2: u32 = put_byte(out, c1, 110);
            put_byte(out, c2, 32)
        },
        FuzzTokenKind::StructKw => {
            // "struct "
            let c1: u32 = put_byte(out, cursor, 115);
            let c2: u32 = put_byte(out, c1, 116);
            let c3: u32 = put_byte(out, c2, 114);
            let c4: u32 = put_byte(out, c3, 117);
            let c5: u32 = put_byte(out, c4, 99);
            let c6: u32 = put_byte(out, c5, 116);
            put_byte(out, c6, 32)
        },
        FuzzTokenKind::EnumKw => {
            // "enum "
            let c1: u32 = put_byte(out, cursor, 101);
            let c2: u32 = put_byte(out, c1, 110);
            let c3: u32 = put_byte(out, c2, 117);
            let c4: u32 = put_byte(out, c3, 109);
            put_byte(out, c4, 32)
        },
        FuzzTokenKind::LetKw => {
            // "let "
            let c1: u32 = put_byte(out, cursor, 108);
            let c2: u32 = put_byte(out, c1, 101);
            let c3: u32 = put_byte(out, c2, 116);
            put_byte(out, c3, 32)
        },
        FuzzTokenKind::MatchKw => {
            // "match "
            let c1: u32 = put_byte(out, cursor, 109);
            let c2: u32 = put_byte(out, c1, 97);
            let c3: u32 = put_byte(out, c2, 116);
            let c4: u32 = put_byte(out, c3, 99);
            let c5: u32 = put_byte(out, c4, 104);
            put_byte(out, c5, 32)
        },
        FuzzTokenKind::ForKw => {
            // "for "
            let c1: u32 = put_byte(out, cursor, 102);
            let c2: u32 = put_byte(out, c1, 111);
            let c3: u32 = put_byte(out, c2, 114);
            put_byte(out, c3, 32)
        },
        FuzzTokenKind::IdentA  => put_byte(out, cursor, 97),
        FuzzTokenKind::IdentB  => put_byte(out, cursor, 98),
        FuzzTokenKind::IdentC  => put_byte(out, cursor, 99),
        FuzzTokenKind::Lparen  => put_byte(out, cursor, 40),
        FuzzTokenKind::Rparen  => put_byte(out, cursor, 41),
        FuzzTokenKind::Lbrace  => put_byte(out, cursor, 123),
        FuzzTokenKind::Rbrace  => put_byte(out, cursor, 125),
        FuzzTokenKind::Semi    => put_byte(out, cursor, 59),
        FuzzTokenKind::LineFeed => put_byte(out, cursor, 10),
    }
}

// Generate a program of up to 256 tokens, deterministically derived from
// `seed`. Returns the populated length in bytes.
//
// The generator maintains its own LCG state; the seed bootstraps the
// chain. Two runs with the same seed produce identical bytes — that is
// the property the fuzzer asserts about both source-generation and
// compiler behavior on that source.
fn generate_program(seed: u64, out: Slice[u8, 65536]) -> u32 {
    let mut state: LcgState = LcgState { state: seed };
    let mut cursor: u32 = 0;
    #[bound = 256]
    for i in 0..256 {
        // Stop if approaching buffer end (worst case 7-byte token).
        match cursor + 8 < 65536 {
            true => {
                state = lcg_next(state);
                let tok: FuzzTokenKind = pick_token(state);
                cursor = emit_token(out, cursor, tok);
            },
            false => i,
        };
    }
    cursor
}

// Read the makefile-captured outcome file for one seed and hash it.
// Path layout: build/fuzz/<seed_id>.outcome (exit code, diagnostic
// codes, output bytes packed deterministically by the orchestrator).
fn hash_capture(path: Slice[u8, 256]) -> Result[[u8; 32], u32] effects(host-fs-read, host-hash) {
    Ok([0; 32])
}

// Read the golden seed corpus from tests/fuzz/seeds.toml. Caller
// allocates an array of FuzzSeed; this populates `out_count` entries
// up to its capacity.
fn read_seed_corpus(out: Slice[FuzzSeed, 1024]) -> u32 effects(host-fs-read) {
    // Schema (per tests/fuzz/seeds.toml):
    //   [[seed]]
    //   id = 1
    //   value = "0xDEADBEEFCAFEBABE"
    //   expected_outcome_hash = "<sha256-hex>"
    //
    // Real implementation: line-oriented TOML parser, same shape as
    // compiler/budget.phos. Rejects malformed entries; rejects duplicate ids.
    0
}

fn main(
    argv: [Slice[u8, 256]; 256],
    argc: u32,
) -> i32 effects(host-fs-read, host-fs-write, host-stdout, host-stderr, host-hash) {
    // Deterministic-seed grammar fuzzer (E11).
    //
    // Sequence:
    //   1. Read tests/fuzz/seeds.toml into a fixed-capacity FuzzSeed array.
    //
    //   2. Two-step protocol per seed (mirrors phosphoric_test_runner /
    //      phosphoric_conform):
    //
    //      a. The makefile rule has already, per seed:
    //         - generated source bytes via this binary's `--generate <seed_id>`
    //           subcommand (which calls generate_program() and writes to
    //           build/fuzz/<seed_id>.phos),
    //         - invoked pcc on the generated source under each configured
    //           pass profile (parse-only, typeck, effects, full-pewrite),
    //         - captured exit code + stderr + any emitted bytes into
    //           build/fuzz/<seed_id>.outcome.
    //
    //      b. This loop processes the captured outcome files:
    //         - hash_capture() the outcome file.
    //         - sha_eq() against the golden expected_outcome_hash from the
    //           seed corpus.
    //         - Populate FuzzOutcome { panicked, actual_hash, matches_golden }.
    //
    //   3. Emit per-seed "[OK]" / "[FAIL] seed_id=N expected=<hex> actual=<hex>"
    //      lines to host-stdout. Any panicked outcome is a hard fail with
    //      seed value printed for reproducibility.
    //
    //   4. Determinism cross-check: re-run the orchestrator a second time
    //      via `make fuzz-twice` and assert byte-equal outcome files. This
    //      catches non-determinism in the compiler itself.
    //
    //   5. Exit 0 if every seed matches its golden outcome; 1 on first
    //      divergence or panic.
    //
    // The seed corpus stays small (≤ 1024 seeds). The corpus is append-only:
    // new seeds added at release; old seeds never removed. Golden hashes are
    // committed alongside seeds so that any unintended compiler-behavior
    // change shows up as a hash mismatch in CI.
    //
    // Subprocess invocation is not a host-profile primitive; the makefile
    // rule does the running. This function reads captured outputs only.
    0
}
