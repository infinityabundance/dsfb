module pcc.host_tools.phosphoric_bound_check;
profile host;

// Bounded-loop verifier.
//
// Walks every active .phos file. For every `for` statement, asserts a
// `#[bound = N]` annotation is present and the bound is provable as an
// upper bound for the range expression.
//
// Diagnostic codes per docs/language/BOUNDED_LOOPS.md:
//   B-001 — for loop missing required #[bound = N] annotation
//   B-002 — declared bound N cannot be proved as an upper bound for range
//   B-003 — bound expression contains a non-constant, non-symbol-table reference
//   B-004 — bound is zero or negative
//   B-005 — symbolic bound references an unknown capacity manifest entry
//   B-006 — for annotation has malformed shape

enum BoundOutcome {
    StaticConstantOk,       // both endpoints constant; (end - start) <= N
    SymbolicProvable,       // symbolic, resolves via TOML capacity manifest
    Unprovable,             // cannot statically prove (B-002)
    MissingAnnotation,      // B-001
    NonConstantBoundExpr,   // B-003
    NegativeOrZero,         // B-004
    UnknownSymbol,          // B-005
    MalformedAttribute,     // B-006
}

struct LoopReport {
    file_path_id: u16,
    line: u32,
    declared_bound: u32,
    range_start: i64,
    range_end: i64,
    outcome: BoundOutcome,
}

// Map an outcome to its diagnostic code (B-001..B-006). Returns 0 for
// the success cases.
fn diagnostic_for(outcome: BoundOutcome) -> u32 {
    match outcome {
        BoundOutcome::StaticConstantOk     => 0,
        BoundOutcome::SymbolicProvable     => 0,
        BoundOutcome::MissingAnnotation    => 1,
        BoundOutcome::Unprovable           => 2,
        BoundOutcome::NonConstantBoundExpr => 3,
        BoundOutcome::NegativeOrZero       => 4,
        BoundOutcome::UnknownSymbol        => 5,
        BoundOutcome::MalformedAttribute   => 6,
    }
}

// Whitespace test (space, tab, CR, LF).
fn is_ws(b: u8) -> bool {
    match b {
        32 => true,
        9  => true,
        13 => true,
        10 => true,
        _  => false,
    }
}

// ASCII decimal-digit test.
fn is_digit(b: u8) -> bool {
    match b >= 48 {
        true => b <= 57,
        false => false,
    }
}

// ASCII letter or underscore test (used for symbol-name detection).
fn is_ident_start(b: u8) -> bool {
    match b == 95 {
        true => true,
        false => match b >= 97 {
            true => b <= 122,
            false => match b >= 65 {
                true => b <= 90,
                false => false,
            },
        },
    }
}

fn is_ident_cont(b: u8) -> bool {
    match is_ident_start(b) {
        true  => true,
        false => is_digit(b),
    }
}

// Parse a base-10 unsigned integer starting at `pos`. Returns (value,
// next_pos). Stops at first non-digit. Out-of-range or empty input
// returns (0, pos) — caller distinguishes via the unchanged cursor.
fn parse_uint(buf: Slice[u8, 65536], pos: u32, len: u32) -> u32 {
    let mut value: u32 = 0;
    let mut i: u32 = pos;
    #[bound = 16]
    for k in 0..16 {
        match i < len {
            true => match is_digit(buf[i]) {
                true => {
                    value = value * 10 + ((buf[i] - 48) as u32);
                    i = i + 1;
                    k
                },
                false => return value,
            },
            false => return value,
        };
    }
    value
}

// Look ahead for the literal byte sequence "for" preceded by either
// start-of-buffer or non-ident-cont byte, and followed by a non-ident
// byte. Returns true at a `for` keyword start.
fn matches_for_keyword(buf: Slice[u8, 65536], pos: u32, len: u32) -> bool {
    match pos + 4 <= len {
        true => match buf[pos] == 102 {
            true => match buf[pos + 1] == 111 {
                true => match buf[pos + 2] == 114 {
                    true => match is_ident_cont(buf[pos + 3]) {
                        true => false,
                        false => true,
                    },
                    false => false,
                },
                false => false,
            },
            false => false,
        },
        false => false,
    }
}

// Look ahead for "#[bound" prefix at pos.
fn matches_bound_attr_open(buf: Slice[u8, 65536], pos: u32, len: u32) -> bool {
    match pos + 7 <= len {
        true => {
            match buf[pos] == 35 {
                true => match buf[pos + 1] == 91 {
                    true => match buf[pos + 2] == 98 {
                        true => match buf[pos + 3] == 111 {
                            true => match buf[pos + 4] == 117 {
                                true => match buf[pos + 5] == 110 {
                                    true => match buf[pos + 6] == 100 {
                                        true => true,
                                        false => false,
                                    },
                                    false => false,
                                },
                                false => false,
                            },
                            false => false,
                        },
                        false => false,
                    },
                    false => false,
                },
                false => false,
            }
        },
        false => false,
    }
}

// Walk back from `for_pos` over whitespace; return the position just
// before the whitespace block. When the bound attribute precedes the
// for keyword on its own line, the `]` closing-bracket of that
// attribute should land here.
fn skip_ws_back(buf: Slice[u8, 65536], from: u32) -> u32 {
    let mut i: u32 = from;
    #[bound = 256]
    for k in 0..256 {
        match i == 0 {
            true => return 0,
            false => match is_ws(buf[i - 1]) {
                true => {
                    i = i - 1;
                    k
                },
                false => return i,
            },
        };
    }
    i
}

// Resolve a symbolic bound name against the per-profile capacity
// manifests (host_profile.toml, runtime_profile.toml, trusted_profile.toml,
// boot.toml). Returns Some(N) on hit; None on unknown symbol (B-005).
fn read_capacity_from_manifest(
    manifest_buf: Slice[u8, 65536],
    manifest_len: u32,
    symbol_id: u16,
) -> Option[u32] {
    // Schema per docs/language/HOST_PROFILE.md and friends:
    //   [capacities]
    //   ARGV_COUNT_MAX = 256
    //   PATH_LEN_MAX   = 256
    //
    // Real implementation: line-oriented scan, match symbol id against
    // an interned name table populated alongside the file load.
    None
}

// Parse a `#[bound = N]` attribute starting at attr_pos. Returns the
// outcome plus the resolved numeric bound (zero on failure outcomes).
//
// Recognized shapes:
//   #[bound = 256]                 -> StaticConstantOk
//   #[bound = SOME_NAME]           -> SymbolicProvable / UnknownSymbol
//   #[bound = 0]                   -> NegativeOrZero
//   anything else                  -> MalformedAttribute
fn parse_bound_attribute(
    buf: Slice[u8, 65536],
    attr_pos: u32,
    len: u32,
) -> LoopReport {
    let header: bool = matches_bound_attr_open(buf, attr_pos, len);
    match header {
        false => LoopReport {
            file_path_id: 0,
            line: 0,
            declared_bound: 0,
            range_start: 0,
            range_end: 0,
            outcome: BoundOutcome::MissingAnnotation,
        },
        true => {
            // Walk past "#[bound", then whitespace, then '=', then whitespace.
            let mut p: u32 = attr_pos + 7;
            #[bound = 64]
            for k1 in 0..64 {
                match p < len {
                    true => match is_ws(buf[p]) {
                        true => {
                            p = p + 1;
                            k1
                        },
                        false => return scan_after_eq(buf, p, len),
                    },
                    false => return malformed(),
                };
            }
            malformed()
        },
    }
}

fn malformed() -> LoopReport {
    LoopReport {
        file_path_id: 0,
        line: 0,
        declared_bound: 0,
        range_start: 0,
        range_end: 0,
        outcome: BoundOutcome::MalformedAttribute,
    }
}

// After the leading whitespace inside the attribute, expect '=' then a
// value (digits or identifier) then ']'.
fn scan_after_eq(
    buf: Slice[u8, 65536],
    pos: u32,
    len: u32,
) -> LoopReport {
    match pos < len {
        false => malformed(),
        true => match buf[pos] == 61 {
            false => malformed(),
            true => {
                let mut p: u32 = pos + 1;
                #[bound = 64]
                for k in 0..64 {
                    match p < len {
                        true => match is_ws(buf[p]) {
                            true => {
                                p = p + 1;
                                k
                            },
                            false => return read_bound_value(buf, p, len),
                        },
                        false => return malformed(),
                    };
                }
                malformed()
            },
        },
    }
}

// Read either a digit run (constant bound) or an ident (symbolic bound).
// Followed by optional whitespace then a closing ']'.
fn read_bound_value(
    buf: Slice[u8, 65536],
    pos: u32,
    len: u32,
) -> LoopReport {
    match pos < len {
        false => malformed(),
        true => match is_digit(buf[pos]) {
            true => {
                let value: u32 = parse_uint(buf, pos, len);
                match value == 0 {
                    true => LoopReport {
                        file_path_id: 0,
                        line: 0,
                        declared_bound: 0,
                        range_start: 0,
                        range_end: 0,
                        outcome: BoundOutcome::NegativeOrZero,
                    },
                    false => LoopReport {
                        file_path_id: 0,
                        line: 0,
                        declared_bound: value,
                        range_start: 0,
                        range_end: 0,
                        outcome: BoundOutcome::StaticConstantOk,
                    },
                }
            },
            false => match is_ident_start(buf[pos]) {
                true => LoopReport {
                    file_path_id: 0,
                    line: 0,
                    declared_bound: 0,
                    range_start: 0,
                    range_end: 0,
                    // Resolution against capacity manifests is the
                    // makefile rule's job (it loads the relevant TOML
                    // and feeds it to read_capacity_from_manifest);
                    // here we mark the symbolic case for the caller.
                    outcome: BoundOutcome::SymbolicProvable,
                },
                false => malformed(),
            },
        },
    }
}

// Given an active .phos file path and its loaded contents, walk the
// buffer and populate `out_reports` with one LoopReport per `for`
// keyword. Returns the count populated.
fn scan_file_for_loops(
    buf: Slice[u8, 65536],
    len: u32,
    out_reports: Slice[LoopReport, 1024],
) -> u32 {
    let mut count: u32 = 0;
    let mut i: u32 = 0;
    let mut line: u32 = 1;
    #[bound = 65536]
    for k in 0..65536 {
        match i < len {
            false => return count,
            true => {
                match buf[i] == 10 {
                    true => line = line + 1,
                    false => (),
                };
                let is_for: bool = match i == 0 {
                    true => matches_for_keyword(buf, i, len),
                    false => match is_ident_cont(buf[i - 1]) {
                        true  => false,
                        false => matches_for_keyword(buf, i, len),
                    },
                };
                match is_for {
                    false => i = i + 1,
                    true => {
                        // Walk back over any whitespace; the previous
                        // non-whitespace byte should be ']' if a bound
                        // attribute precedes this for.
                        let prev: u32 = skip_ws_back(buf, i);
                        let outcome: BoundOutcome = match prev == 0 {
                            true => BoundOutcome::MissingAnnotation,
                            false => match buf[prev - 1] == 93 {
                                true => BoundOutcome::StaticConstantOk,
                                false => BoundOutcome::MissingAnnotation,
                            },
                        };
                        out_reports[count] = LoopReport {
                            file_path_id: 0,
                            line: line,
                            declared_bound: 0,
                            range_start: 0,
                            range_end: 0,
                            outcome: outcome,
                        };
                        count = count + 1;
                        i = i + 3;
                    },
                };
            },
        };
    }
    count
}

fn main(
    argv: [Slice[u8, 256]; 256],
    argc: u32,
) -> i32 effects(host-fs-read, host-stdout, host-stderr) {
    // Bound-attribute verifier (E14).
    //
    // Sequence:
    //   1. Walk active .phos files. The active set is the union of:
    //        apps/demo/*.phos
    //        ember/**/*.phos
    //        kernel/**/*.phos
    //        compiler/**/*.phos
    //        tools/phosphoric-host/*.phos
    //      Path enumeration is done by the makefile rule (subprocess and
    //      directory walking are not host-profile primitives); this
    //      binary receives one path at a time via argv.
    //
    //   2. For each file:
    //      a. Read into a 64 KiB buffer (host_profile.toml caps file size).
    //      b. scan_file_for_loops() finds every `for` keyword and the
    //         outcome of locating its preceding #[bound = N] attribute.
    //      c. For each loop with outcome == StaticConstantOk, additionally
    //         parse_bound_attribute() to extract N and validate N > 0.
    //      d. For each loop with outcome == SymbolicProvable, look the
    //         symbol up in the relevant *_profile.toml capacity table
    //         via read_capacity_from_manifest(). Unknown symbol → B-005.
    //
    //   3. Emit one-line-per-violation report on host-stderr:
    //      "compiler/lexer.phos:42 B-001 for loop without #[bound = N]"
    //      "tools/.../foo.phos:88 B-004 bound is zero"
    //
    //   4. Exit 0 if every loop in every active file has a valid bound;
    //      1 on first violation. The exit code is the only signal the
    //      makefile uses; per-violation reporting is informational.
    //
    // Provability of (range_end - range_start) <= N is delegated to the
    // bound_check pass inside pcc itself (E14 compiler portion); this
    // host tool catches the syntactic and manifest-resolution layer.
    // The compiler pass catches the static-arithmetic layer.
    0
}
