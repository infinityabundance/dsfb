# Pass B-3 fixture: __load32(IMM_ADDR) primitive emits a leaf load fn.
# Body `return __load32(4194400);` lowers to a 24-byte block:
#   push rbp; mov rbp,rsp; sub rsp,16
#   mov edi, 0x400060      ; ELF p_filesz address
#   mov eax, [rdi]         ; load u32
#   add rsp,16; pop rbp; ret; nop nop nop
# The helper is unreachable from entry (entry returns 0), so rc=0; the
# helper's bytes are still emitted and locked here at byte level.
