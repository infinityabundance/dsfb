module demo.demo_state;

struct BootFramebuffer {
    width: u32,
    height: u32,
    stride: u32,
    bytes_per_pixel: u32,
    pixel_format: u32,
}

struct DemoState {
    framebuffer_width: u32,
    framebuffer_height: u32,
    framebuffer_stride: u32,
    framebuffer_bytes_per_pixel: u32,
    framebuffer_pixel_format: u32,
    window_x: u32,
    window_y: u32,
    window_w: u32,
    window_h: u32,
    cursor_x: u32,
    cursor_y: u32,
    button_pressed: u32,
    input_routed: u32,
    focused_window: u32,
    reserved0: u32,
}

fn initial_window_x() -> u32 { 48 }

fn initial_window_y() -> u32 { 48 }

fn initial_window_w() -> u32 { 220 }

fn initial_window_h() -> u32 { 140 }

fn initial_cursor_x() -> u32 { 72 }

fn initial_cursor_y() -> u32 { 72 }

fn initial_button_pressed() -> u32 { 0 }

fn initial_input_routed() -> u32 { 0 }

fn initial_focused_window() -> u32 { 1 }
