module pcc.sha256;
profile host;

// SHA-256 implementation for the host-profile compiler.
//
// Used by codegen_boot.phos compute_certificates to derive the eight
// .pmanifest certificates. Determinism is the load-bearing claim:
// identical input bytes MUST produce identical 32-byte output. The
// implementation uses bitwise operators introduced in the V0 grammar
// extension (2026-04-28) — &, |, ^, <<, >>.
//
// Reference: FIPS 180-4 SHA-256.

// Initial hash values (H0..H7 from FIPS 180-4 §5.3.3).
fn h_init() -> [u32; 8] {
    [
        0x6a09e667,
        0xbb67ae85,
        0x3c6ef372,
        0xa54ff53a,
        0x510e527f,
        0x9b05688c,
        0x1f83d9ab,
        0x5be0cd19,
    ]
}

// Round constants K[0..63] (FIPS 180-4 §4.2.2).
fn k_constants() -> [u32; 64] {
    [
        0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5,
        0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
        0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3,
        0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
        0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc,
        0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
        0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7,
        0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
        0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13,
        0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
        0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3,
        0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
        0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5,
        0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
        0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208,
        0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
    ]
}

// Rotate-right of a 32-bit value by n bits. Phosphoric v0 has no
// rotation instruction; synthesized from shifts and bitwise OR.
fn rotr(x: u32, n: u32) -> u32 {
    (x >> n) | (x << (32 - n))
}

// Big-Sigma 0: ROTR(x,2) ^ ROTR(x,13) ^ ROTR(x,22)
fn bsig0(x: u32) -> u32 {
    rotr(x, 2) ^ rotr(x, 13) ^ rotr(x, 22)
}

// Big-Sigma 1: ROTR(x,6) ^ ROTR(x,11) ^ ROTR(x,25)
fn bsig1(x: u32) -> u32 {
    rotr(x, 6) ^ rotr(x, 11) ^ rotr(x, 25)
}

// Small-Sigma 0: ROTR(x,7) ^ ROTR(x,18) ^ (x >> 3)
fn ssig0(x: u32) -> u32 {
    rotr(x, 7) ^ rotr(x, 18) ^ (x >> 3)
}

// Small-Sigma 1: ROTR(x,17) ^ ROTR(x,19) ^ (x >> 10)
fn ssig1(x: u32) -> u32 {
    rotr(x, 17) ^ rotr(x, 19) ^ (x >> 10)
}

// Choose: (x & y) ^ (~x & z). Phosphoric has no `~`; use x ^ 0xFFFFFFFF.
fn ch(x: u32, y: u32, z: u32) -> u32 {
    (x & y) ^ ((x ^ 0xFFFFFFFF) & z)
}

// Majority: (x & y) ^ (x & z) ^ (y & z)
fn maj(x: u32, y: u32, z: u32) -> u32 {
    (x & y) ^ (x & z) ^ (y & z)
}

// Read 4 big-endian bytes from buf at offset, return as u32.
fn read_be_u32(buf: Slice[u8, 1024], offset: u32) -> u32 {
    ((buf[offset] as u32) << 24)
        | ((buf[offset + 1] as u32) << 16)
        | ((buf[offset + 2] as u32) << 8)
        | (buf[offset + 3] as u32)
}

// Write a u32 as 4 big-endian bytes into out at offset.
fn write_be_u32(out: Slice[u8, 32], offset: u32, value: u32) -> u32 {
    out[offset]     = ((value >> 24) & 255) as u8;
    out[offset + 1] = ((value >> 16) & 255) as u8;
    out[offset + 2] = ((value >> 8) & 255) as u8;
    out[offset + 3] = (value & 255) as u8;
    offset + 4
}

// Process one 64-byte block, updating H in place.
fn process_block(h: [u32; 8], block: Slice[u8, 1024], block_offset: u32) -> [u32; 8] {
    // 1. Prepare message schedule W[0..63].
    let mut w: [u32; 64] = [0; 64];
    #[bound = 16]
    for t in 0..16 {
        w[t] = read_be_u32(block, block_offset + (t as u32) * 4);
    }
    #[bound = 48]
    for i in 0..48 {
        let t: u32 = (i + 16) as u32;
        w[t] = ssig1(w[t - 2]) + w[t - 7] + ssig0(w[t - 15]) + w[t - 16];
    }
    // 2. Init working variables.
    let mut a: u32 = h[0];
    let mut b: u32 = h[1];
    let mut c: u32 = h[2];
    let mut d: u32 = h[3];
    let mut e: u32 = h[4];
    let mut f: u32 = h[5];
    let mut g: u32 = h[6];
    let mut hh: u32 = h[7];
    let k: [u32; 64] = k_constants();
    // 3. 64 rounds of the compression function.
    #[bound = 64]
    for t in 0..64 {
        let t1: u32 = hh + bsig1(e) + ch(e, f, g) + k[t] + w[t];
        let t2: u32 = bsig0(a) + maj(a, b, c);
        hh = g;
        g = f;
        f = e;
        e = d + t1;
        d = c;
        c = b;
        b = a;
        a = t1 + t2;
    }
    // 4. Add to hash state.
    [
        h[0] + a,
        h[1] + b,
        h[2] + c,
        h[3] + d,
        h[4] + e,
        h[5] + f,
        h[6] + g,
        h[7] + hh,
    ]
}

// Top-level SHA-256: take an input buffer + length (≤ 1024 bytes) and
// produce a 32-byte digest. The input length is bounded by the buffer
// capacity; longer inputs would require a streaming API.
//
// Padding (FIPS 180-4 §5.1.1):
//   1. Append 0x80.
//   2. Append zeros until length ≡ 56 (mod 64).
//   3. Append the original length in bits as a 64-bit big-endian integer.
fn sha256_hash(input: Slice[u8, 1024], len: u32) -> [u8; 32] effects(host-hash) {
    let mut padded: [u8; 1088] = [0; 1088];     // 1024 + worst-case 64-byte trailing
    #[bound = 1024]
    for i in 0..len {
        padded[i] = input[i];
    }
    padded[len] = 0x80;
    // Length in bits as big-endian u64. v0 has no native u64 shift on
    // u32-typed operands; use modular arithmetic for the high 32 bits.
    let bit_len_lo: u32 = len * 8;
    let bit_len_hi: u32 = 0;
    // Padded length: ceil((len + 1 + 8) / 64) * 64
    let pre: u32 = len + 1 + 8;
    let blocks: u32 = (pre + 63) >> 6;       // / 64
    let padded_len: u32 = blocks << 6;       // * 64
    padded[padded_len - 8] = ((bit_len_hi >> 24) & 255) as u8;
    padded[padded_len - 7] = ((bit_len_hi >> 16) & 255) as u8;
    padded[padded_len - 6] = ((bit_len_hi >> 8) & 255) as u8;
    padded[padded_len - 5] = (bit_len_hi & 255) as u8;
    padded[padded_len - 4] = ((bit_len_lo >> 24) & 255) as u8;
    padded[padded_len - 3] = ((bit_len_lo >> 16) & 255) as u8;
    padded[padded_len - 2] = ((bit_len_lo >> 8) & 255) as u8;
    padded[padded_len - 1] = (bit_len_lo & 255) as u8;
    // Process each 64-byte block.
    let mut h: [u32; 8] = h_init();
    let block_view: Slice[u8, 1024] = padded;     // first 1024 bytes
    #[bound = 17]                                 // 1088/64 = 17
    for b in 0..blocks {
        h = process_block(h, block_view, (b as u32) << 6);
    }
    // Output 32-byte digest.
    let mut out: [u8; 32] = [0; 32];
    let mut o: u32 = 0;
    #[bound = 8]
    for i in 0..8 {
        o = write_be_u32(out, o, h[i]);
    }
    out
}
