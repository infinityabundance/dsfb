module ember.arch.cortex_m33.boot;
profile trusted;

// Cortex-M33 (RP2350) boot reset handler.
//
// Sequence (per RP2350 datasheet section 5.4 + the project's razor design):
//   1. Read OTP-burned signing-key hash (otp.phos)
//   2. Verify image signature against the hash
//   3. Configure SAU regions: secure = Ember + runtime, non-secure = apps
//   4. Configure MPU: stack guards + secure-flash RO post-boot
//   5. Hand off to the runtime kernel with a typed BootInfo

enum BootStage {
    OtpReadStarted,
    SignatureVerifying,
    SauConfigured,
    HandoffReady,
}

struct Rp2350BootInfo {
    flash_base: u32,
    flash_size: u32,
    sram_base: u32,
    sram_size: u32,
    secure_region_base: u32,
    secure_region_size: u32,
}

// Reset handler entry. Called by the RP2350 ROM bootloader after OTP is
// powered up and the initial stack pointer is set.
//
// Returns the BootStage reached on success; on hardware fault, the trap
// handler in traps.phos converts to a typed BootError.
fn reset_handler() -> Rp2350BootInfo {
    // Stage 1 — OTP-burned signing key hash readout.
    // ember.arch.cortex_m33.otp.read_signed_boot_key_hash() returns 8 u32
    // words composing the 256-bit SHA-256 of the trusted public key.
    let _key_hash: [u32; 8] = ember.arch.cortex_m33.otp.read_signed_boot_key_hash();

    // Stage 2 — signature verification (real implementation hands the
    // hash + image to a downstream verify_image_signature primitive
    // which lands when the on-chip signed-boot path is wired). For the
    // current razor-skeleton, the verification call is named in the
    // trust audit but the actual signature check lives in the bootrom.

    // Stage 3 — SAU regions. The secure region covers the Ember nucleus +
    // the runtime kernel; non-secure covers application code and data.
    // Region 0 = secure flash (Ember + runtime).
    // Region 1 = non-secure flash (apps).
    // Region 2 = secure SRAM (kernel state).
    // Region 3 = non-secure SRAM (app heap; forbidden in v0).
    let secure_region: ember.arch.cortex_m33.sau.SauRegion =
        ember.arch.cortex_m33.sau.SauRegion {
            base: 268435456,             // 0x10000000 (RP2350 flash secure base)
            end_inclusive: 268697599,    // 0x1003FFFF (256 KiB Ember+runtime ceiling)
            attribute: ember.arch.cortex_m33.sau.SauAttribute::Secure,
            enabled: true,
        };
    ember.arch.cortex_m33.sau.configure_sau_region(0, secure_region);
    ember.arch.cortex_m33.sau.enable_sau();

    // Stage 4 — MPU configuration. Stack-guard low + high pages for the
    // kernel stack; secure-flash RO; peripheral-RO bracket.
    let stack_guard_low: ember.arch.cortex_m33.mpu.MpuRegion =
        ember.arch.cortex_m33.mpu.MpuRegion {
            purpose: ember.arch.cortex_m33.mpu.MpuRegionPurpose::StackGuardLow,
            base: 536870912,             // 0x20000000 (RP2350 SRAM base)
            size_log2: 5,                // 2^5 = 32 bytes
            permissions_attr: 0,         // no-access for the guard page
        };
    ember.arch.cortex_m33.mpu.configure_mpu_region(0, stack_guard_low);
    ember.arch.cortex_m33.mpu.enable_mpu();

    // Hand off shape: the runtime kernel takes a BootInfo describing the
    // memory map and the framebuffer region. RP2350 has no framebuffer;
    // the kernel adapts via the runtime profile's null-framebuffer path.
    Rp2350BootInfo {
        flash_base: 268435456,           // 0x10000000
        flash_size: 4194304,             // 4 MiB
        sram_base: 536870912,            // 0x20000000
        sram_size: 524288,               // 512 KiB
        secure_region_base: 268435456,
        secure_region_size: 262144,      // 256 KiB
    }
}
