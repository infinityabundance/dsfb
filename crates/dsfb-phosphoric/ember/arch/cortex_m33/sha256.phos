module ember.arch.cortex_m33.sha256;
profile trusted;

// RP2350 SHA-256 hardware accelerator wrapper.
//
// Used by the host-hash effect lowering on cortex_m33: golden-fixture
// verification, image hashing, dsfb-gray attestation hashing. Software
// SHA-256 is forbidden in trusted profile on this arch (Z-002 if attempted).

struct Sha256State {
    bytes_consumed: u32,
    final_emitted: bool,
}

struct Sha256Digest {
    bytes: [u8; 32],
}

fn empty_sha256_state() -> Sha256State {
    Sha256State { bytes_consumed: 0, final_emitted: false }
}

fn empty_sha256_digest() -> Sha256Digest {
    Sha256Digest { bytes: [0; 32] }
}

// RP2350 SHA-256 engine MMIO base. Pinned per the RP2350 peripheral map.
fn sha256_engine_base() -> u32 {
    1124237312          // 0x40158000
}

// Engine register offsets (per RP2350 datasheet section 9.5).
fn sha256_reg_csr() -> u32     { 0  }
fn sha256_reg_wdata() -> u32   { 4  }
fn sha256_reg_dig0() -> u32    { 32 }     // first of 8 digest words

// Reset the engine to a fresh state. Required before each new hash.
//
// razor-rationale: language-not-expressible — engine reset is a control
// register write that affects internal state machines outside the type
// system's expression.
fn sha256_reset() {
    let csr_addr: u32 = sha256_engine_base() + sha256_reg_csr();
    // trust-audit: row "SHA-256 reset" in ember/docs/EMBER_TRUST_AUDIT.md
    // razor-rationale: language-not-expressible: reset clears engine state
    trusted!{
        mmio_write_u32(csr_addr, 1);
    };
}

// Feed one 32-bit data word into the engine.
//
// razor-rationale: irreducible-hw — direct write into the engine's data
// register. Software emulation is forbidden by trusted-profile alphabet.
fn sha256_feed_u32(word: u32) {
    let wdata_addr: u32 = sha256_engine_base() + sha256_reg_wdata();
    // trust-audit: row "SHA-256 feed word" in ember/docs/EMBER_TRUST_AUDIT.md
    // razor-rationale: irreducible-hw
    trusted!{
        mmio_write_u32(wdata_addr, word);
    };
}

// Read one of the 8 32-bit digest output registers.
fn sha256_read_digest_word(index: u8) -> u32 {
    let addr: u32 = sha256_engine_base() + sha256_reg_dig0() + (index as u32) * 4;
    // trust-audit: row "SHA-256 digest read" in ember/docs/EMBER_TRUST_AUDIT.md
    // razor-rationale: irreducible-hw
    trusted!{
        mmio_read_u32(addr)
    }
}

// Read all 8 digest words and pack them into a 32-byte digest. Each word
// is big-endian within the 4-byte slot per FIPS 180-4.
fn sha256_finalize_read() -> Sha256Digest {
    let mut out: Sha256Digest = empty_sha256_digest();
    #[bound = 8]
    for i in 0..8 {
        let word: u32 = sha256_read_digest_word(i as u8);
        let base: u32 = (i as u32) * 4;
        out.bytes[base + 0] = (word / 16777216) as u8;
        out.bytes[base + 1] = ((word / 65536) - ((word / 16777216) * 256)) as u8;
        out.bytes[base + 2] = ((word / 256)   - ((word / 65536)   * 256)) as u8;
        out.bytes[base + 3] = (word - (word / 256) * 256) as u8;
    }
    out
}

// ---------------------------------------------------------------------------
// Public hash entrypoint — `sha256_hash_buffer`
//
// Hashes an arbitrary-length byte buffer using the on-chip SHA-256 engine.
// This is the canonical hash primitive that the runtime kernel and any
// host-hash effect lowering on cortex_m33 dispatches through.
//
// Speed: the RP2350 SHA-256 engine completes a 256-byte block in roughly
// 80 cycles at 150 MHz (~0.5 µs). Software SHA-256 over the same input
// would take >50 µs. Golden-fixture verification (E5 corpus comparison)
// becomes millisecond-class on the MCU instead of multi-second.
//
// Padding follows FIPS 180-4 §5.1.1: append 0x80, zeros to (mod 64 == 56),
// then a 64-bit big-endian length in bits.
// ---------------------------------------------------------------------------

fn sha256_hash_buffer(
    buf: Slice[u8, 65536],
    len: u32,
) -> Sha256Digest {
    sha256_reset();
    // Walk the input in 4-byte groups, packing into u32s for the engine.
    // Big-endian per FIPS 180-4 (the engine's Wdata register expects big-endian).
    let full_words: u32 = len / 4;
    #[bound = 16384]
    for i in 0..full_words {
        let base: u32 = i * 4;
        let word: u32 =
            (buf[base + 0] as u32) * 16777216
            + (buf[base + 1] as u32) * 65536
            + (buf[base + 2] as u32) * 256
            + (buf[base + 3] as u32);
        sha256_feed_u32(word);
    }
    // Tail bytes plus the FIPS 180-4 padding byte 0x80.
    let tail_bytes: u32 = len - full_words * 4;
    let mut tail_word: u32 = 0;
    let mut shift: u32 = 16777216;       // 2^24, the high byte slot
    #[bound = 4]
    for i in 0..tail_bytes {
        tail_word = tail_word + (buf[full_words * 4 + i] as u32) * shift;
        shift = shift / 256;
    }
    // Append 0x80 immediately after the tail bytes.
    tail_word = tail_word + 128 * shift;
    sha256_feed_u32(tail_word);
    // Zero-pad through to (mod 64 == 56). Compute words consumed so far
    // (in 4-byte words): full_words + 1 (for tail+0x80). Pad until 14 mod 16.
    let mut consumed_words: u32 = full_words + 1;
    let target_words: u32 = match consumed_words <= 14 {
        true  => 14,
        false => 14 + 16,
    };
    let pad_words: u32 = target_words - consumed_words;
    #[bound = 16]
    for _ in 0..pad_words {
        sha256_feed_u32(0);
    }
    // Length in bits (big-endian 64-bit). High word is 0 for any buffer
    // <= 2^29 bytes (the addressable range here is 65536 anyway).
    sha256_feed_u32(0);
    let bit_len: u32 = len * 8;
    sha256_feed_u32(bit_len);
    sha256_finalize_read()
}

// Compute a SHA-256 of a u8 slice and return whether it matches an
// expected digest. Used by golden-fixture verification (E5) and any
// runtime-side image-hash check on cortex_m33.
fn sha256_hash_matches(
    buf: Slice[u8, 65536],
    len: u32,
    expected: Sha256Digest,
) -> bool {
    let actual: Sha256Digest = sha256_hash_buffer(buf, len);
    let mut all_match: bool = true;
    #[bound = 32]
    for i in 0..32 {
        match actual.bytes[i] == expected.bytes[i] {
            true  => (),
            false => all_match = false,
        };
    }
    all_match
}
