let%span slib'12 = "/tmp/dsfb_creusot/src/lib.rs" 4 0 4 20

use creusot.int.Int64
use creusot.int.Int128
use creusot.prelude.Any
use int.Int

type t_CoordClass = Interior | Grazing | Outside

constant const_SCALE: Int64.t = [%#slib'12] (1000000: Int64.t)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let classify_axis [#"/tmp/dsfb_creusot/src/lib.rs" 20 0 20 78] (v: Int64.t) (lo: Int64.t) (hi: Int64.t)
  (band_scaled: Int64.t) (return (x: t_CoordClass)) =
{[@stop_split] [@expl:classify_axis requires] ([@stop_split] [@expl:classify_axis requires #0] [%#slib'10] Int64.to_int lo
    < Int64.to_int hi)
  /\ ([@stop_split] [@expl:classify_axis requires #1] [%#slib'11] 0 <= Int64.to_int band_scaled
  /\ Int64.to_int band_scaled < Int64.to_int const_SCALE)}
  (! bb0
  [ bb0 = s0
    [ s0 = [ &_12 <- Int128.of_int (Int64.to_int v) ] s1
    | s1 = Int128.mul [%#slib'0] {[%#slib] (2: Int128.t)} {_12} (fun (_x: Int128.t) -> [ &_11 <- _x ] s2)
    | s2 = [ &_15 <- Int128.of_int (Int64.to_int hi) ] s3
    | s3 = [ &_17 <- Int128.of_int (Int64.to_int lo) ] s4
    | s4 = Int128.add [%#slib'1] {_15} {_17} (fun (_x: Int128.t) -> [ &_14 <- _x ] s5)
    | s5 = Int128.sub [%#slib'2] {_11} {_14} (fun (_x: Int128.t) -> [ &d2 <- _x ] s6)
    | s6 = [ &_20 <- Int128.of_int (Int64.to_int hi) ] s7
    | s7 = [ &_22 <- Int128.of_int (Int64.to_int lo) ] s8
    | s8 = Int128.sub [%#slib'3] {_20} {_22} (fun (_x: Int128.t) -> [ &width <- _x ] s9)
    | s9 = [ &_25 <- Int128.lt d2 ([%#slib'4] (0: Int128.t)) ] s10
    | s10 = any [ br0 -> {_25 = false} (! bb2) | br1 -> {_25} (! bb1) ] ]
  | bb1 = s0 [ s0 = Int128.neg {d2} (fun (_x: Int128.t) -> [ &ad2 <- _x ] s1) | s1 = bb3 ]
  | bb2 = s0 [ s0 = [ &ad2 <- d2 ] s1 | s1 = bb3 ]
  | bb3 = s0
    [ s0 = [ &_28 <- Int128.gt ad2 width ] s1 | s1 = any [ br0 -> {_28 = false} (! bb5) | br1 -> {_28} (! bb4) ] ]
  | bb4 = s0 [ s0 = [ &_ret <- Outside ] s1 | s1 = return {_ret} ]
  | bb5 = s0
    [ s0 = [ &_34 <- Int128.of_int (Int64.to_int ([%#slib'5] const_SCALE)) ] s1
    | s1 = Int128.mul [%#slib'6] {ad2} {_34} (fun (_x: Int128.t) -> [ &_32 <- _x ] s2)
    | s2 = [ &_38 <- Int128.of_int (Int64.to_int ([%#slib'7] const_SCALE)) ] s3
    | s3 = [ &_39 <- Int128.of_int (Int64.to_int band_scaled) ] s4
    | s4 = Int128.sub [%#slib'8] {_38} {_39} (fun (_x: Int128.t) -> [ &_37 <- _x ] s5)
    | s5 = Int128.mul [%#slib'9] {width} {_37} (fun (_x: Int128.t) -> [ &_35 <- _x ] s6)
    | s6 = [ &_31 <- Int128.ge _32 _35 ] s7
    | s7 = any [ br0 -> {_31 = false} (! bb7) | br1 -> {_31} (! bb6) ] ]
  | bb6 = s0 [ s0 = [ &_ret <- Grazing ] s1 | s1 = return {_ret} ]
  | bb7 = s0 [ s0 = [ &_ret <- Interior ] s1 | s1 = return {_ret} ] ]
  [ & _ret: t_CoordClass = Any.any_l ()
  | & v: Int64.t = v
  | & lo: Int64.t = lo
  | & hi: Int64.t = hi
  | & band_scaled: Int64.t = band_scaled
  | & d2: Int128.t = Any.any_l ()
  | & _11: Int128.t = Any.any_l ()
  | & _12: Int128.t = Any.any_l ()
  | & _14: Int128.t = Any.any_l ()
  | & _15: Int128.t = Any.any_l ()
  | & _17: Int128.t = Any.any_l ()
  | & width: Int128.t = Any.any_l ()
  | & _20: Int128.t = Any.any_l ()
  | & _22: Int128.t = Any.any_l ()
  | & ad2: Int128.t = Any.any_l ()
  | & _25: bool = Any.any_l ()
  | & _28: bool = Any.any_l ()
  | & _31: bool = Any.any_l ()
  | & _32: Int128.t = Any.any_l ()
  | & _34: Int128.t = Any.any_l ()
  | & _35: Int128.t = Any.any_l ()
  | & _37: Int128.t = Any.any_l ()
  | & _38: Int128.t = Any.any_l ()
  | & _39: Int128.t = Any.any_l () ]) [ return (result: t_CoordClass) -> (! return {result}) ]
