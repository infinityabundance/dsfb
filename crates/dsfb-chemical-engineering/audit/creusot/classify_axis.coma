let%span slib = "/tmp/dsfb_creusot/src/lib.rs" 21 19 21 24
let%span slib'0 = "/tmp/dsfb_creusot/src/lib.rs" 21 19 21 38
let%span slib'1 = "/tmp/dsfb_creusot/src/lib.rs" 21 41 21 66
